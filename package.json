{
  "name": "ui-e2e-testing",
  "version": "1.0.0",
  "private": true,
  "description": "UI end-to-end tests of OWASP Juice Shop: user journeys from registration to order history, Page Objects with role locators, API login with storageState, cross-browser and mobile, traces and videos in Allure, flaky-test tracking. TypeScript + Playwright Test, GitHub Actions.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "shop:up": "docker run -d --rm --name juice-shop -p 3000:3000 bkimminich/juice-shop:v20.3.0",
    "shop:down": "docker stop juice-shop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "node scripts/allure-prepare.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  }
}
